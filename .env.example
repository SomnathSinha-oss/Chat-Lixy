# ==============================================================================
# ChatLixy Environment Variables
# ==============================================================================

# Node.js SSR Backend Configuration
PORT=3001
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173
JWT_SECRET=chatlixy-super-secret-jwt-signing-key-32chars-minimum!

# Supabase Credentials (Optional for local simulated fallback, required for live Supabase)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Vite Frontend Variables
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here
